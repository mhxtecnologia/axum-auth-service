# Copie para .env para mudar os valores do docker-compose.
# São credenciais de desenvolvimento local; em produção use um gerenciador de segredos.
POSTGRES_USER=auth
# Os testes (configuration/local.yaml) esperam a senha "auth".
POSTGRES_PASSWORD=auth
POSTGRES_DB=auth
RUST_LOG=info

# Produção: toda chave da configuração pode vir por variável APP_<SECAO>__<CHAVE>.
# APP_ENVIRONMENT=production
# APP_DATABASE__HOST=db.internal
# APP_DATABASE__PASSWORD=
# APP_REDIS__URL=redis://:password@redis.internal:6379
# APP_JWT__PRIVATE_KEY_PEM=   (PEM PKCS#8: openssl genpkey -algorithm ed25519)
# APP_RATE_LIMIT__TRUST_X_FORWARDED_FOR=true   (só atrás de um proxy confiável)
